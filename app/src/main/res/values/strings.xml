    <!-- Period Info Dialog -->
    <string name="period_info_title">Filtering Statistics by Date</string>
    <string name="period_info_content">You can filter the chart and statistics using the buttons below:</string>
    <string name="period_info_day">• Day — shows data only for today</string>
    <string name="period_info_week">• Week — shows data from the last 7 days</string>
    <string name="period_info_month">• Month — shows data from the last 30 days</string>
    <string name="period_info_all">• All — shows all available historical data</string>
    <string name="period_info_custom">• Custom — allows you to select a specific date range</string>
    <string name="period_info_how_to">📌 How to use Custom range:\n\n1. Tap Custom (Inny) — a calendar will open\n2. Select the start date → tap Next\n3. Select the end date → tap Apply\n\nThe chart will then display data from the start date to the day before the end date (e.g., 03.05.2026 – 10.05.2026 shows data from 03.05 to 09.05).</string>
    <string name="period_info_note">Only data recorded during the selected period will be shown in the chart and statistics.</string>

