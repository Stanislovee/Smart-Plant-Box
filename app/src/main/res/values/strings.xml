    <!-- Privacy Notice Dialog -->
    <string name="privacy_notice_title">Privacy Notice</string>
    <string name="privacy_info_collect_title">1. Information We Collect</string>
    <string name="privacy_info_collect_text">• Account information (name, email)\n• Device sensor data (temperature, humidity, light, soil moisture)\n• Usage patterns and preferences</string>
    <string name="privacy_use_info_title">2. How We Use Your Information</string>
    <string name="privacy_use_info_text">• Provide plant care recommendations\n• Improve our products and services\n• Send important notifications\n• Analyze usage trends</string>
    <string name="privacy_data_sharing_title">3. Data Sharing</string>
    <string name="privacy_data_sharing_text">We do not sell your personal data. We may share data with:\n• Service providers (hosting, analytics)\n• Legal authorities when required by law</string>
    <string name="privacy_data_security_title">4. Data Security</string>
    <string name="privacy_data_security_text">We use encryption and secure servers to protect your data. However, no internet transmission is 100% secure.</string>
    <string name="privacy_your_rights_title">5. Your Rights</string>
    <string name="privacy_your_rights_text">• Access and update your data\n• Delete your account\n• Opt out of marketing emails\n• Request data export</string>
    <string name="privacy_data_retention_title">6. Data Retention</string>
    <string name="privacy_data_retention_text">We keep your data while your account is active. After deletion, data is removed within 30 days.</string>
    <string name="privacy_contact_title">7. Contact Us</string>
    <string name="privacy_contact_text">Privacy questions: privacy@smartplantbox.com</string>

